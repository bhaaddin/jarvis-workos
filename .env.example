# Generated secrets belong in .env. Run: python scripts/init.py
OPENCLAW_GATEWAY_TOKEN=__GATEWAY_TOKEN__
JARVIS_WORKFLOW_TOKEN=__WORKFLOW_TOKEN__
N8N_ENCRYPTION_KEY=__ENCRYPTION_KEY__
JARVIS_PROJECT_TOKEN=__PROJECT_TOKEN__
JARVIS_VOICE_TOKEN=__VOICE_TOKEN__
SEARXNG_SECRET=__SEARXNG_SECRET__
TZ=Etc/UTC

# Operational core: scripts/operator_brain.py up generates these private values.
# JARVIS_OPERATOR_GATEWAY_TOKEN=<generated>
# JARVIS_OPERATOR_DATA_KEY=<generated; retain for encrypted-data recovery>
# JARVIS_OPERATOR_ADMIN_PASSWORD=<generated staging login password>
# JARVIS_OPERATOR_CALLBACK_KEY=<generated>
# Optional operational settings (defaults shown):
# JARVIS_OPERATOR_ENV=staging
# JARVIS_OPERATOR_TENANT=sportmedical-local
# JARVIS_OPERATOR_TIMEZONE=Europe/Prague
# JARVIS_OPERATOR_GATEWAY_URL=http://127.0.0.1:18809
# JARVIS_PUBLIC_ORIGIN=http://127.0.0.1:18801
# Telegram bridge state lives in runtime/telegram/ (token + allowlist), not here.
# Optional WhatsApp/telephone route (Twilio, not yet activated):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_SENDER=
# TWILIO_VOICE_NUMBER=
