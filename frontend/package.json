{
  "name": "jarvis-command-center",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node ../scripts/build-stamp.mjs write frontend",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:voice": "playwright test --config=playwright.voice.config.ts",
    "test:notebook": "playwright test --config=playwright.notebook.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
