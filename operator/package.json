{
  "name": "jarvis-operator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node ../scripts/build-stamp.mjs write operator",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "node scripts/verify.mjs",
    "probe": "node scripts/probe.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cron-parser": "5.10.1",
    "fastify": "5.12.5",
    "imapflow": "2.1.0",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "mailparser": "3.9.29",
    "nodemailer": "10.0.11",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "typescript": "7.0.2"
  }
}
