{
  "manifestVersion": 1, "id": "jarvis_action_status", "version": "1.0.0",
  "description": "Read the current authoritative state of the user's action. Awaiting approval, queued, uncertain, failed and succeeded are distinct. This tool cannot approve or execute anything.",
  "handler": "handler.mjs", "environments": ["dev","staging","prod"],
  "permissions": ["actions.read"], "risk": "read", "serviceOperations": ["actions.status"], "sensitivity": "internal", "requires": [],
  "inputSchema": {"type":"object","required":["id"],"properties":{"id":{"type":"string","format":"uuid"}},"additionalProperties":false},
  "outputSchema": {"type":"object","required":["id","state","tool","reason","errorCode"],"properties":{"id":{"type":"string"},"state":{"type":"string"},"tool":{"type":"string"},"reason":{"type":"string"},"errorCode":{"type":["string","null"]}},"additionalProperties":false},
  "idempotent": true, "supportsUndo": false, "publicProjection": true, "timeoutMs": 5000
}
