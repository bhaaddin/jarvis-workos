{
  "manifestVersion": 1, "id": "jarvis_capabilities", "version": "1.0.0",
  "description": "Inspect installed skills and their actual readiness. Configured, fixture, and live integrations are different states; never claim a missing account is connected.",
  "handler": "handler.mjs", "environments": ["dev","staging","prod"],
  "permissions": ["skills.read"], "risk": "read", "serviceOperations": ["core.capabilities"], "sensitivity": "internal", "requires": [],
  "inputSchema": {"type":"object","properties":{},"additionalProperties":false},
  "outputSchema": {"type":"object","required":["environment","skills"],"properties":{"environment":{"type":"string"},"skills":{"type":"array","items":{"type":"object"}}},"additionalProperties":false},
  "idempotent": true, "supportsUndo": false, "publicProjection": true, "timeoutMs": 5000
}
