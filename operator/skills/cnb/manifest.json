{"manifestVersion":1,"id":"jarvis_cnb","version":"1.0.0","description":"Read the Czech National Bank daily exchange-rate table (CZK base) or one currency. Free, no key. Retrieval date is the CNB publication date, not today's market price.","handler":"handler.mjs","environments":["dev","staging"],"permissions":["operator.chat"],"risk":"read","serviceOperations":["cnb.rates"],"sensitivity":"public","requires":[],"inputSchema":{"type":"object","properties":{"currency":{"type":"string","pattern":"^[A-Z]{3}$"}},"additionalProperties":false},"outputSchema":{"type":"object"},"idempotent":true,"supportsUndo":false,"publicProjection":true,"timeoutMs":20000}