{"manifestVersion":1,"id":"jarvis_code_read","version":"1.0.0","description":"Read paged source files from connected personal working projects. Use jarvis_projects to discover project ids first. Credential files, symlinks and binary files are refused. Edits and build/test runs use jarvis_code and need approval.","handler":"handler.mjs","environments":["dev","staging"],"permissions":["sandbox.execute"],"risk":"read","serviceOperations":["code.read"],"sensitivity":"internal","requires":[],"inputSchema":{"type":"object","required":["project","path"],"properties":{"project":{"type":"string","minLength":1,"maxLength":80},"path":{"type":"string","minLength":1,"maxLength":500},"start":{"type":"integer","minimum":1},"limit":{"type":"integer","minimum":1,"maximum":500}},"additionalProperties":false},"outputSchema":{"type":"object"},"idempotent":true,"supportsUndo":false,"publicProjection":false,"timeoutMs":20000}